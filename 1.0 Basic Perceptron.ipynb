   "source": [
    "import numpy as np "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8fe61b63",
   "metadata": {},
   "outputs": [],
   "source": [
    "X = np.array([2, 3, 4])\n",
    "w = np.array([0.2, 0.5, 0.3])\n",
    "b = 0.1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "004cec03",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Weighted sum: 3.2\n"
     ]
    }
   ],
   "source": [
    "z = np.dot(X, w)+b\n",
    "print(\"Weighted sum:\", z)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "32db72da",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Neuron output: 0.9608342772032357\n"
     ]
    }
   ],
   "source": [
    "y = 1/(1+np.exp(-z))\n",
    "print(\"Neuron output:\", y)"
   ]
  }
